<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Maximiliano</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Outfit',sans-serif;
scroll-behavior:smooth;
}

body{
background:#ffffff;
color:#111;
}

nav{

position:fixed;
top:0;
width:100%;

display:flex;
justify-content:space-between;
align-items:center;


backdrop-filter:blur(15px);

border-bottom:1px solid #eee;

z-index:100;

}

.logo{

font-size:30px;
font-weight:500;
color:#15518E;

}

nav ul{

display:flex;
gap:35px;
list-style:none;

}

nav a{

text-decoration:none;
color:#111;

}

.hero{

min-height:100vh;

display:flex;
flex-direction:column;
align-items:center;
justify-content:center;

padding:120px 8%;

gap:40px;

text-align:center;

}

.hero h1{

font-size:80px;
line-height:1.1;
letter-spacing:2px;

}

.hero h1 span{

color:#15518E;

}

.profile{

display:flex;
justify-content:center;

}

.profile-img{

width:300px;
height:340px;

border-radius:30px;

object-fit:cover;

box-shadow:0 20px 60px rgba(0,0,0,.08);

transition:.35s;

max-width:100%;

}

.profile-img:hover{

transform:translateY(-8px);

}

section{

padding:100px 8%;

}

.title{

font-size:40px;
margin-bottom:40px;

}

.grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:25px;

}

.box{

padding:30px;

border-radius:22px;

background:white;

border:1px solid #eee;

transition:.3s;

}

.box:hover{

transform:translateY(-8px);

box-shadow:0 20px 40px rgba(0,0,0,.08);

}

footer{

padding:60px;
text-align:center;
color:#777;

}

@media(max-width:900px){

.hero{

padding:100px 5% 60px;

}

nav ul{

display:none;

}

.hero h1{

font-size:45px;

}

.profile-img{

width:280px;
height:320px;

}


section{

padding:60px 5%;

}

.title{

font-size:32px;

}

}

@media(max-width:500px){

nav{

padding:15px 5%;

}

.logo{

font-size:24px;

}

.hero{

padding:80px 5% 40px;

}

.hero h1{

font-size:32px;

}

.profile-img{

width:220px;
height:280px;

}

section{

padding:40px 5%;

}

.title{

font-size:26px;

}

.box{

padding:20px;

}

footer{

padding:40px 5%;
font-size:14px;

}

}

</style>

</head>

<body>

<nav>

<div class="logo">M.</div>

<ul>

<li><a href="#">Inicio</a></li>
<li><a href="#about">Sobre mí</a></li>
<li><a href="#projects">Proyectos</a></li>

</ul>

</nav>

<div class="hero">

<div>

<h1>We are <span>Month</span></h1>

</div>

<div class="profile">

<img class="profile-img" src="Logo.png" alt="Logo Month">

</div>

</div>

<section id="about">

<h2 class="title">Tecnologías</h2>

<div class="grid">

<div class="box">

<h3>Flutter</h3>

<p>Aplicaciones Android modernas.</p>

</div>

<div class="box">

<h3>Firebase</h3>

<p>Backend y almacenamiento.</p>

</div>

<div class="box">

<h3>HTML / CSS</h3>

<p>Interfaces limpias y responsive.</p>

</div>

<div class="box">

<h3>JavaScript</h3>

<p>Experiencias dinámicas.</p>

</div>

</div>

</section>

<section id="projects">

<h2 class="title">Proyectos</h2>

<div class="grid">

<div class="box">

<h3>Month</h3>

<p>Agenda moderna para organizar horarios.</p>

</div>

<div class="box">

<h3>Portfolio</h3>

<p>Diseño minimalista y elegante.</p>

</div>

</div>

</section>

<footer>

© 2026 Maximiliano

</footer>

</body>
</html>
